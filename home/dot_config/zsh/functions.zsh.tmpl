# Return success when PROFILE includes TOOL in its configured tool list.
_profile-enabled() {
	case "$1:$2" in{{ "\n" -}}
{{-   range $account, $config := $accounts -}}
{{-     $tools := includeTemplate "accounts/tools" (dict "account" $config) | fromJson -}}
{{-     range $tool := $tools -}}
{{-       printf "\t\"%s:%s\") return 0 ;;\n" $tool $account -}}
{{-     end -}}
{{-   end -}}
		*) return 1 ;;
	esac
}

# Set GitHub credentials and the Git identity and signing settings for a profile.
_profile-git-config() {
	local account="$1" gh_enabled="${2:-1}" git_config_parameters=''
	if [[ "$gh_enabled" == 1 ]]; then
		git_config_parameters="'credential.helper=' 'credential.helper=!gh auth git-credential'"
	fi
	unset GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0 GIT_CONFIG_KEY_1 GIT_CONFIG_VALUE_1
	case "$account" in{{ "\n" -}}
{{-   range $account, $config := $accounts -}}
{{-     $profileData := dict -}}
{{-     $tools := includeTemplate "accounts/tools" (dict "account" $config) | fromJson -}}
{{-     $gitConfig := dict -}}
{{-     if not (kindIs "slice" $config) -}}
{{-       $profileData = $config -}}
{{-       $gitConfig = index $config "git" | default dict -}}
{{-     end -}}
{{-     $gitName := printf "%v" (index $gitConfig "name" | default (index $profileData "name" | default "")) -}}
{{-     $gitEmail := printf "%v" (index $gitConfig "email" | default (index $profileData "email" | default "")) -}}
{{-     $ghConfig := index $profileData "gh" | default dict -}}
{{-     $gitGpgSign := $rootGpgSign -}}
{{-     if hasKey $gitConfig "gpgsign" -}}
{{-       $gitGpgSign = index $gitConfig "gpgsign" -}}
{{-     end -}}
{{-     if hasKey $ghConfig "gpgsign" -}}
{{-       $gitGpgSign = index $ghConfig "gpgsign" -}}
{{-     end -}}
{{-     if not (kindIs "bool" $gitGpgSign) -}}
{{-       fail (printf "gpgsign for profile %q must be a boolean" $account) -}}
{{-     end -}}
{{-     $signingKey := get $ghConfig "signingKey" | default "" -}}
{{-     $sshKey := get $ghConfig "sshKey" | default "" -}}
{{-     $username := get $ghConfig "username" | default "" -}}
{{-     if and (hasKey $ghConfig "signingKey") (not (kindIs "string" (get $ghConfig "signingKey"))) -}}
{{-       fail (printf "gh.signingKey for profile %q must be a string" $account) -}}
{{-     end -}}
{{-     if and (hasKey $ghConfig "sshKey") (not (kindIs "string" (get $ghConfig "sshKey"))) -}}
{{-       fail (printf "gh.sshKey for profile %q must be a string" $account) -}}
{{-     end -}}
{{-     if and (ne $username "") (not (and (kindIs "string" $username) (regexMatch "^[A-Za-z0-9-]+$" $username))) -}}
{{-       fail (printf "gh.username for profile %q is invalid" $account) -}}
{{-     end -}}
{{-     if and $username (eq $sshKey "") -}}
{{-       $sshPath := get $sshGh "path" | default "~/.config/gh/ssh" -}}
{{-       if not (and (kindIs "string" $sshPath) (or (eq $sshPath "~") (hasPrefix "~/" $sshPath) (hasPrefix "/" $sshPath))) -}}
{{-         fail "ssh.gh.path must be ~, a home-relative path starting with ~/, or an absolute path when a profile SSH key is missing" -}}
{{-       end -}}
{{-       $sshKey = printf "%s/id_ed25519_github_%s" (trimSuffix "/" $sshPath) $username -}}
{{-     end -}}
{{-     if and (eq $signingKey "") (ne $sshKey "") -}}
{{-       $signingKey = printf "%s.pub" $sshKey -}}
{{-     end -}}
{{-     $sshCommand := "" -}}
{{-     if ne $sshKey "" -}}
{{-       $sshCommand = printf "ssh -F none -o %q -o IdentitiesOnly=yes" (printf "IdentityFile=%s" $sshKey) -}}
{{-     end -}}
{{-     if has "git" $tools -}}
{{-       printf "\t\"%s\")\n" $account -}}
{{-       if $gitName -}}
{{-         printf "\t\tgit_config_parameters=\"${git_config_parameters}${git_config_parameters:+ }'user.name=%s'\"\n" (replace "'" "'\\''" $gitName) -}}
{{-       end -}}
{{-       if $gitEmail -}}
{{-         printf "\t\tgit_config_parameters=\"${git_config_parameters}${git_config_parameters:+ }'user.email=%s'\"\n" (replace "'" "'\\''" $gitEmail) -}}
{{-       end -}}
{{-       if $signingKey -}}
{{-         printf "\t\tgit_config_parameters=\"${git_config_parameters}${git_config_parameters:+ }'user.signingkey=%s'\"\n" (replace "'" "'\\''" $signingKey) -}}
{{-       end -}}
{{-       printf "\t\tgit_config_parameters=\"${git_config_parameters}${git_config_parameters:+ }'commit.gpgsign=%t'\"\n" $gitGpgSign -}}
{{-       if $sshCommand -}}
{{-         $escapedSshCommand := replace "'" "'\\''" $sshCommand | replace "\"" "\\\"" -}}
{{-         printf "\t\tgit_config_parameters=\"${git_config_parameters}${git_config_parameters:+ }'core.sshCommand=%s'\"\n" $escapedSshCommand -}}
{{-       end -}}
{{-       printf "\t\t;;\n" -}}
{{-     end -}}
{{-   end -}}
		*) ;;
	esac
	if [[ -n "$git_config_parameters" ]]; then
		export GIT_CONFIG_PARAMETERS="$git_config_parameters"
	else
		unset GIT_CONFIG_PARAMETERS
	fi
}

# Clear profile-specific paths before launching a default or unprofiled application.
_profile-clear-environment() {
	unset CODEX_HOME CLAUDE_CONFIG_DIR COPILOT_HOME GEMINI_CLI_HOME GH_CONFIG_DIR
}

# Remove inherited GitHub tokens so gh uses the selected profile's credentials.
_profile-clear-gh-environment() {
	unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
}

# Use the profile's isolated GitHub CLI configuration.
use-gh() {
	local account="$1" profile_dir="$HOME/{{ $profilesDir }}/$1/gh"
	if ! _profile-enabled gh "$account"; then
		print -u2 "use: GitHub CLI is not configured for profile: $account"
		return 1
	fi
	command mkdir -p -- "$profile_dir"
	_profile-clear-gh-environment
	unset GIT_CONFIG_PARAMETERS
	export GH_CONFIG_DIR="$profile_dir"
}

# Start VS Code with its profile-specific environment.
use-code() {
	local account="$1" gh_profile_enabled=0
	local vscode_profile="$account"
	local -a profile_env=()
	shift

	case "$account" in{{ "\n" -}}
{{-   range $account, $config := $accounts -}}
{{-     if not (kindIs "slice" $config) -}}
{{-       with index $config "name" -}}
{{-         printf "\t\"%s\") vscode_profile=%s ;;\n" $account (. | quote) -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   printf "\tesac\n" }}
	case "$account" in{{ "\n" -}}
{{-   range $account, $config := $accounts -}}
{{-     $tools := includeTemplate "accounts/tools" (dict "account" $config) | fromJson -}}
{{-     if has "vscode" $tools -}}
{{-       printf "\t\"%s\")\n" $account -}}
{{-       printf "\t\tprofile_env+=(\"GH_CONFIG_DIR=$HOME/%s/%s/gh\")\n" $profilesDir $account -}}
{{-       range $tool := $tools -}}
{{-         if eq $tool "codex" -}}
{{-           printf "\t\tprofile_env+=(\"CODEX_HOME=$HOME/%s/%s/codex\")\n" $profilesDir $account -}}
{{-         else if eq $tool "claude" -}}
{{-           printf "\t\tprofile_env+=(\"CLAUDE_CONFIG_DIR=$HOME/%s/%s/claude\")\n" $profilesDir $account -}}
{{-         else if eq $tool "copilot" -}}
{{-           printf "\t\tprofile_env+=(\"COPILOT_HOME=$HOME/%s/%s/copilot\")\n" $profilesDir $account -}}
{{-         else if eq $tool "gemini" -}}
{{-           printf "\t\tprofile_env+=(\"GEMINI_CLI_HOME=$HOME/%s/%s/gemini\")\n" $profilesDir $account -}}
{{-         else if eq $tool "gh" -}}
{{-           printf "\t\tgh_profile_enabled=1\n" -}}
{{-         end -}}
{{-       end -}}
{{-       printf "\t\t;;\n" -}}
{{-     end -}}
{{-   end -}}
{{-   printf "\t*) ;;\n\tesac\n" }}

	# VS Code may reuse an existing process and keep its original environment.
	(
		_profile-clear-gh-environment
		_profile-git-config "$account" "$gh_profile_enabled"
		if [[ "$vscode_profile" == "Default" ]]; then
			_profile-clear-environment
		fi
		command env "${profile_env[@]}" code --profile "$vscode_profile" "$@"
	)
}

# Run Git with the selected profile's GitHub credentials and author identity.
use-git() {
	local account="$1"
	shift
	(
		if _profile-enabled gh "$account"; then
			use-gh "$account" || return $?
		else
			_profile-clear-gh-environment
			unset GH_CONFIG_DIR
		fi
		_profile-git-config "$account"
		command git "$@"
	)
}

# Start a supported CLI with its profile-specific state directory.
use-cli() {
	local tool="$1" account="$2" profile_dir env_name cli
	shift 2

	if [[ "$tool" == gh ]]; then
		(
			use-gh "$account" || return $?
			_profile-git-config "$account" 0
			command gh "$@"
		)
		return $?
	fi

	profile_dir="$HOME/{{ $profilesDir }}/$account/$tool"
	if [[ ! -d "$profile_dir" ]]; then
		print -u2 "use: profile not found: $tool/$account"
		return 1
	fi

	case "$tool" in
		codex) env_name=CODEX_HOME; cli=codex ;;
		claude) env_name=CLAUDE_CONFIG_DIR; cli=claude ;;
		copilot) env_name=COPILOT_HOME; cli=copilot ;;
		gemini) env_name=GEMINI_CLI_HOME; cli=gemini ;;
	esac

	command env "$env_name=$profile_dir" "$cli" "$@"
}

# use TOOL PROFILE [arguments...] starts a CLI with an isolated state directory.
use() {
	if (( $# < 2 )); then
		print -u2 'Usage: use TOOL PROFILE [arguments...]'
		return 2
	fi
	local tool="$1" account="$2"
	case "$tool" in
		codex|claude|copilot|gemini|gh|git|vscode) ;;
		*) print -u2 'use: TOOL must be codex, claude, copilot, gemini, gh, git, or vscode'; return 2 ;;
	esac
	if [[ ! "$account" =~ '^[a-zA-Z0-9._-]+$' || "$account" == '.' || "$account" == '..' ]]; then
		print -u2 'use: profile name may contain only letters, numbers, dot, underscore, and hyphen'
		return 2
	fi
	if ! _profile-enabled "$tool" "$account"; then
		if [[ "$tool" != vscode || "$account" != Default ]]; then
			print -u2 "use: profile is not configured for $tool: $account"
			return 1
		fi
	fi
	shift 2
	case "$tool" in
		vscode) use-code "$account" "$@" ;;
		git) use-git "$account" "$@" ;;
		*) use-cli "$tool" "$account" "$@" ;;
	esac
}

