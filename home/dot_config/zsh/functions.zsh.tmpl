{{-     if not (regexMatch "^[a-zA-Z0-9._-]+$" $account) }}
{{-       fail (printf "invalid profile name %q" $account) }}
{{-     end }}

{{-     $tools := includeTemplate "accounts/tools" (dict "account" $config) | fromJson }}
{{-     range $tool := $tools }}
{{-       if not (or
					(eq $tool "codex")
					(eq $tool "claude")
					(eq $tool "copilot")
					(eq $tool "gemini")
					(eq $tool "gh")
					(eq $tool "git")
					(eq $tool "vscode")
					(eq $tool "antigravity")
				)
				}}
{{-         fail (printf "unsupported profile tool %q in profile %q" $tool $account) }}
{{-       end }}
{{-     end }}

{{-     if not (kindIs "slice" $config) }}
{{-       $gitConfig := index $config "git" | default dict }}
{{-       if not (kindIs "map" $gitConfig) }}
{{-         fail (printf "git config for profile %q must be a table" $account) }}
{{-       end }}

{{-       if has "gh" $tools }}
{{-         $ghConfig := index $config "gh" | default dict }}
{{-         if not (kindIs "map" $ghConfig) }}
{{-           fail (printf "gh config for profile %q must be a table" $account) }}
{{-         end }}
{{-       end }}
{{-     end }}
