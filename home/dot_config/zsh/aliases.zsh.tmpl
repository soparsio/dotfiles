#!/usr/bin/env zsh

# Navigation and file listings
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias la="ls -A"
alias ll="ls -lah"

# Git shortcuts
alias ga="git add"
alias gs="git status --short --branch"
alias gd="git diff"
alias gds="git diff --staged"
alias gb="git branch"
alias gco="git checkout"
alias gcm="git commit -m"
alias gl="git log --oneline --graph --decorate -15"
alias gpl="git pull --ff-only"
alias gp="git push"

# System shortcuts
alias dfh="df -h"

# Shell shortcuts
alias reload="source ~/.zshrc"

# Docker shortcuts
alias dps="docker ps --format 'table {{ "{{" }}.Names{{ "}}" }}\t{{ "{{" }}.Status{{ "}}" }}\t{{ "{{" }}.Ports{{ "}}" }}'"
alias dcu="docker compose up -d"
alias dcd="docker compose down"

# Path shortcuts
{{- $path := index . "path" | default dict }}
{{- if not (kindIs "map" $path) }}
{{-   fail "path must be a table" }}
{{- end }}
{{- $aliases := index $path "aliases" | default dict }}
{{- if not (kindIs "map" $aliases) }}
{{-   fail "path.aliases must be a table" }}
{{- end }}
{{- $pathAliases := dict }}
{{- $reservedAliases := dict }}
{{- range (list ".." "..." "...." "la" "ll" "ga" "gs" "gd" "gds" "gb" "gco" "gcm" "gl" "gpl" "gp" "dfh" "reload" "dps" "dcu" "dcd" "c") }}
{{-   $_ := set $reservedAliases . true }}
{{- end }}
{{- $accounts := includeTemplate "accounts/by-id" . | fromJson }}
{{- $vscode := (index . "vscode") | default dict }}
{{- if $accounts }}
{{-   $_ := set $reservedAliases "dotfiles" true }}
{{-   if index $vscode "defaultProfile" }}
{{-     $_ := set $reservedAliases "code" true }}
{{-   end }}
{{-   range $account, $config := $accounts }}
{{-     $tools := includeTemplate "accounts/tools" (dict "account" $config) | fromJson }}
{{-     range $tool := $tools }}
{{-       if eq $tool "vscode" }}
{{-         $_ := set $reservedAliases (printf "code-%v" $account) true }}
{{-         $_ := set $reservedAliases (printf "dotfiles-%v" $account) true }}
{{-       else if not (or (eq $tool "antigravity") (eq $tool "gh") (eq $tool "git")) }}
{{-         $_ := set $reservedAliases (printf "%v-%v" $tool $account) true }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
{{- range $alias, $targetPath := $aliases }}
{{-   if not (kindIs "string" $alias) }}
{{-     fail (printf "path alias name %q must be a string" $alias) }}
{{-   end }}
{{-   if not (regexMatch "^[A-Za-z_][A-Za-z0-9._-]*$" $alias) }}
{{-     fail (printf "invalid path alias %q" $alias) }}
{{-   end }}
{{-   if hasKey $reservedAliases $alias }}
{{-     fail (printf "path alias %q conflicts with another generated alias" $alias) }}
{{-   end }}
{{-   if hasKey $pathAliases $alias }}
{{-     fail (printf "duplicate path alias %q" $alias) }}
{{-   end }}
{{-   $_ := set $pathAliases $alias true }}
{{-   if not (kindIs "string" $targetPath) }}
{{-     fail (printf "path alias %q target must be a string" $alias) }}
{{-   end }}
{{-   if not $targetPath }}
{{-     fail (printf "path alias %q requires a target path" $alias) }}
{{-   end }}
{{-   if regexMatch "[[:cntrl:]]" $targetPath }}
{{-     fail (printf "path alias %q target must not contain control characters" $alias) }}
{{-   end }}
{{-   $aliasTarget := "" }}
{{-   if eq $targetPath "~" }}
{{-     $aliasTarget = "\"$HOME\"" }}
{{-   else if hasPrefix "~/" $targetPath }}
{{-     $pathPrefix := trimPrefix "~/" $targetPath }}
{{-     $escapedPath := $pathPrefix | replace "\\" "\\\\" | replace "\"" "\\\"" | replace "$" "\\$" | replace "`" "\\`" }}
{{-     $aliasTarget = printf "\"$HOME\"/\"%s\"" $escapedPath }}
{{-   else if hasPrefix "/" $targetPath }}
{{-     $escapedPath := $targetPath | replace "\\" "\\\\" | replace "\"" "\\\"" | replace "$" "\\$" | replace "`" "\\`" }}
{{-     $aliasTarget = printf "\"%s\"" $escapedPath }}
{{-   else }}
{{-     fail (printf "path alias %q target must be ~, a home-relative path starting with ~/, or an absolute path" $alias) }}
{{-   end }}
{{-   $aliasValue := printf "builtin cd -- %s" $aliasTarget | replace "'" "'\\''" }}
alias {{ $alias }}='{{ $aliasValue }}'
{{- end }}
alias c="claude"
alias dotfiles='profile-use vscode Default "$(dirname "$(chezmoi source-path)")"'
{{ if $accounts }}
{{-   with (index $vscode "defaultProfile") }}
{{-     $defaultProfile := . }}
{{-     if eq $defaultProfile "Default" }}
alias code='profile-use vscode Default'
{{-     else }}
{{-       $config := index $accounts $defaultProfile }}
{{-       if not $config }}
{{-         fail (printf "default profile %q is not configured" $defaultProfile) }}
{{-       end }}
{{-       $tools := includeTemplate "accounts/tools" (dict "account" $config) | fromJson }}
{{-       if not (has "vscode" $tools) }}
{{-         fail (printf "default profile %q must enable vscode" $defaultProfile) }}
{{-       end }}
alias code='profile-use vscode {{ $defaultProfile }}'
{{-     end }}
{{     "\n" -}}
{{-   end }}
{{-   range $account, $config := $accounts -}}
{{-     $tools := includeTemplate "accounts/tools" (dict "account" $config) | fromJson -}}
{{-     range $tool := $tools -}}
{{-       if eq $tool "vscode" -}}
alias code-{{ $account }}='profile-use vscode {{ $account }}'
{{-         "\n" -}}
alias dotfiles-{{ $account }}='profile-use vscode {{ $account }} "$(dirname "$(chezmoi source-path)")"'
{{-         "\n" -}}
{{-       else if not (or (eq $tool "antigravity") (eq $tool "gh") (eq $tool "git")) -}}
alias {{ $tool }}-{{ $account }}='profile-use {{ $tool }} {{ $account }}'
{{-         "\n" -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end }}
