#!/usr/bin/env zsh

# Navigation and file listings
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias la="ls -A"
alias ll="ls -lah"

# Git shortcuts
alias ga="git add"
alias gs="git status --short --branch"
alias gd="git diff"
alias gds="git diff --staged"
alias gb="git branch"
alias gco="git checkout"
alias gcm="git commit -m"
alias gl="git log --oneline --graph --decorate -15"
alias gpl="git pull --ff-only"
alias gp="git push"

# System shortcuts
alias dfh="df -h"

# Shell shortcuts
alias reload="source ~/.zshrc"

# Docker shortcuts
alias dps="docker ps --format 'table {{ "{{" }}.Names{{ "}}" }}\t{{ "{{" }}.Status{{ "}}" }}\t{{ "{{" }}.Ports{{ "}}" }}'"
alias dcu="docker compose up -d"
alias dcd="docker compose down"

# Path shortcuts
{{- $path := index . "path" | default dict }}
{{- $pathAliases := dict }}
{{- $reservedAliases := dict }}
{{- range (list ".." "..." "...." "la" "ll" "ga" "gs" "gd" "gds" "gb" "gco" "gcm" "gl" "gpl" "gp" "dfh" "reload" "dps" "dcu" "dcd" "c") }}
  {{- $_ := set $reservedAliases . true }}
{{- end }}
{{- $profiles := (index . "profiles") | default dict }}
{{- if $profiles }}
  {{- $_ := set $reservedAliases "dotfiles" true }}
  {{- if index . "defaultProfile" }}
    {{- $_ := set $reservedAliases "code" true }}
  {{- end }}
  {{- range $profile, $config := $profiles }}
    {{- $tools := $config }}
    {{- if not (kindIs "slice" $config) }}
      {{- $tools = index $config "tools" }}
    {{- end }}
    {{- range $tool := $tools }}
      {{- if eq $tool "vscode" }}
        {{- $_ := set $reservedAliases (printf "code-%v" $profile) true }}
        {{- $_ := set $reservedAliases (printf "dotfiles-%v" $profile) true }}
      {{- else if not (or (eq $tool "antigravity") (eq $tool "gh") (eq $tool "git")) }}
        {{- $_ := set $reservedAliases (printf "%v-%v" $tool $profile) true }}
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}
{{- range $name, $settings := $path }}
  {{- if not (kindIs "map" $settings) }}
    {{- fail (printf "path entry %q must be a table" $name) }}
  {{- end }}
  {{- $alias := index $settings "alias" }}
  {{- if and (hasKey $settings "alias") (not (kindIs "string" $alias)) }}
    {{- fail (printf "path entry %q alias must be a string" $name) }}
  {{- end }}
  {{- if $alias }}
    {{- if not (regexMatch "^[A-Za-z_][A-Za-z0-9._-]*$" $alias) }}
      {{- fail (printf "invalid path alias %q for %q" $alias $name) }}
    {{- end }}
    {{- if hasKey $reservedAliases $alias }}
      {{- fail (printf "path alias %q conflicts with another generated alias" $alias) }}
    {{- end }}
    {{- if hasKey $pathAliases $alias }}
      {{- fail (printf "duplicate path alias %q" $alias) }}
    {{- end }}
    {{- $_ := set $pathAliases $alias true }}
    {{- $targetPath := index $settings "path" | default "" }}
    {{- if not (kindIs "string" $targetPath) }}
      {{- fail (printf "path entry %q path must be a string" $name) }}
    {{- end }}
    {{- if not $targetPath }}
      {{- fail (printf "path entry %q requires a path when it defines alias %q" $name $alias) }}
    {{- end }}
    {{- if not (hasPrefix "~/" $targetPath) }}
      {{- fail (printf "path entry %q path must be a home-relative path starting with ~/" $name) }}
    {{- end }}
    {{- $pathPrefix := trimPrefix "~/" $targetPath }}
    {{- if regexMatch "[[:cntrl:]]" $pathPrefix }}
      {{- fail (printf "path entry %q path must not contain control characters" $name) }}
    {{- end }}
    {{- $escapedPath := $pathPrefix | replace "\\" "\\\\" | replace "\"" "\\\"" | replace "$" "\\$" | replace "`" "\\`" }}
    {{- $aliasValue := printf "builtin cd -- \"$HOME\"/\"%s\"" $escapedPath | replace "'" "'\\''" }}
alias {{ $alias }}='{{ $aliasValue }}'
  {{- end }}
{{- end }}
alias c="claude"
alias dotfiles='profile-use vscode Default "$(dirname "$(chezmoi source-path)")"'
{{ if $profiles }}
  {{- with (index . "defaultProfile") }}
    {{- $defaultProfile := . }}
    {{- if eq $defaultProfile "Default" }}
alias code='profile-use vscode Default'
    {{- else }}
      {{- $config := index $profiles $defaultProfile }}
      {{- if not $config }}
        {{- fail (printf "default profile %q is not configured" $defaultProfile) }}
      {{- end }}
      {{- $tools := $config }}
      {{- if not (kindIs "slice" $config) }}
        {{- $tools = index $config "tools" }}
      {{- end }}
      {{- if not (has "vscode" $tools) }}
        {{- fail (printf "default profile %q must enable vscode" $defaultProfile) }}
      {{- end }}
alias code='profile-use vscode {{ $defaultProfile }}'
    {{- end }}
{{ "\n" -}}
  {{- end }}
  {{- range $profile, $config := $profiles -}}
    {{- $tools := $config -}}
    {{- if not (kindIs "slice" $config) -}}
      {{- $tools = index $config "tools" -}}
    {{- end -}}
    {{- range $tool := $tools -}}
      {{- if eq $tool "vscode" -}}
alias code-{{ $profile }}='profile-use vscode {{ $profile }}'
      {{- "\n" -}}
alias dotfiles-{{ $profile }}='profile-use vscode {{ $profile }} "$(dirname "$(chezmoi source-path)")"'
      {{- "\n" -}}
      {{- else if not (or (eq $tool "antigravity") (eq $tool "gh") (eq $tool "git")) -}}
alias {{ $tool }}-{{ $profile }}='profile-use {{ $tool }} {{ $profile }}'
      {{- "\n" -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end }}
