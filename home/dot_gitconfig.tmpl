{{- $accounts := includeTemplate "accounts/by-id" . | fromJson -}}
{{- $hasRoot := ne (get . "email" | default "") "" -}}
{{- $totalAccounts := len $accounts -}}
{{- if $hasRoot }}{{ $totalAccounts = add $totalAccounts 1 }}{{ end -}}
{{- $hasMultiAccounts := gt $totalAccounts 1 -}}
{{- $sshConfig := get . "ssh" | default dict -}}
{{- $sshGhConfig := get $sshConfig "gh" | default dict -}}
{{- $rootSshGhAccount := dict -}}
{{- range $sshGhAccount := get $sshGhConfig "accounts" | default (list) -}}
{{-   if get $sshGhAccount "isRoot" -}}
{{-     $rootSshGhAccount = $sshGhAccount -}}
{{-   end -}}
{{- end -}}
{{- $rootSigningKey := get $rootSshGhAccount "signingKey" | default "" -}}
[include]
    path = ~/.config/git/config

[user]
{{- if $hasRoot }}
    name = {{ get $rootSshGhAccount "name" | default .name | quote }}
    email = {{ get $rootSshGhAccount "email" | default .email | quote }}
{{-   if $rootSigningKey }}
    signingkey = {{ $rootSigningKey }}
{{-   end }}
{{- else if $hasMultiAccounts }}
    useConfigOnly = true
{{- end }}
