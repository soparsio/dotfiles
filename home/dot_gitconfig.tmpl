{{- $accounts := includeTemplate "accounts/by-id" . | fromJson -}}
{{- $hasRoot := ne (get . "email" | default "") "" -}}
{{- $totalAccounts := len $accounts -}}
{{- if $hasRoot }}{{ $totalAccounts = add $totalAccounts 1 }}{{ end -}}
{{- $hasMultiAccounts := gt $totalAccounts 1 -}}
{{- $gitConfig := get . "git" | default dict -}}
{{- if and (hasKey . "git") (not (kindIs "map" $gitConfig)) -}}
{{-   fail "git config must be a table" -}}
{{- end -}}
{{- $ghConfig := get . "gh" | default dict -}}
{{- if and (hasKey . "gh") (not (kindIs "map" $ghConfig)) -}}
{{-   fail "gh config must be a table" -}}
{{- end -}}
{{- $signingConfig := includeTemplate "git/signing" (dict "git" $gitConfig "gh" $ghConfig) | fromJson -}}
{{- $gpgSign := get $signingConfig "gpgsign" -}}
{{- $gh := get $signingConfig "gh" -}}
[include]
    path = ~/.config/git/config

[user]
{{- if $hasRoot }}
    name = {{ .name | quote }}
    email = {{ .email | quote }}
{{-   $ghKey := get $gh "sshKey" | default "" -}}
{{-   $ghSig := get $gh "signingKey" | default "" -}}
{{-   if and (eq $ghSig "") (ne $ghKey "") }}{{ $ghSig = printf "%s.pub" $ghKey }}{{ end -}}
{{-   if and $gpgSign (ne $ghSig "") }}
    signingkey = {{ $ghSig }}
{{-   end }}
{{- else if $hasMultiAccounts }}
    useConfigOnly = true
{{- end }}
