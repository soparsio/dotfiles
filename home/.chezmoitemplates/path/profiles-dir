{{- $path := index . "path" | default dict -}}
{{- if not (kindIs "map" $path) -}}
{{-   fail "path must be a table" -}}
{{- end -}}
{{- $profilesPath := index $path "profiles" | default "~/.config/profiles" -}}
{{- if not (kindIs "string" $profilesPath) -}}
{{-   fail "path.profiles must be a home-relative path starting with ~/" -}}
{{- end -}}
{{- if not (hasPrefix "~/" $profilesPath) -}}
{{-   fail "path.profiles must be a home-relative path starting with ~/" -}}
{{- end -}}
{{- trimSuffix "/" (trimPrefix "~/" $profilesPath) -}}
